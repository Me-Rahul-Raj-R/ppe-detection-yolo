# ==============================================================================
# EdgeVision PPE Compliance Platform - Git & Hugging Face Ignore Rules
# ==============================================================================

# ── 1. Python & Virtual Environments ──────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.env
.venv/
venv/
env/

# ── 2. AI Models & Weights ───────────────────────────────────────────────────
# Ignore temporary export formats (TensorRT engines, ONNX exports, training runs)
ppe_training/
runs/
experiments/
*.engine
*.onnx

# KEEP active PyTorch model weights tracked in Git / Hugging Face
!models/
!models/*.pt

# ── 3. Databases & Evidence Files ──────────────────────────────────────────────
# Ignore generated SQLite databases (auto-created by app at runtime)
database/*.db
database/*.sqlite
*.db
*.sqlite

# Ignore video evidence clips (keep directory structure via .gitkeep)
database/evidence/*
!database/evidence/.gitkeep

# ── 4. Frontend & Node.js Dependencies ─────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/.output/
frontend/.wrangler/
frontend/.nitro/
frontend/dist/

# ── 5. Logs, Caches & Temporary Artifacts ─────────────────────────────────────
.pytest_cache/
.benchmarks/
scratch/
cookies.txt
*.log
*.tmp
*.bak

# ── 6. OS & System Files ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.replit
.pythonlibs/
.cache/
.local/
